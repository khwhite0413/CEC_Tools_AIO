# Force CRLF line endings for Windows batch files, regardless of the
# committer's local git config. This applies to git-archive / GitHub
# zipball too, so the auto-updater's robocopy step doesn't get LF-only
# .bat files that cmd.exe silently mangles (setlocal → "tlocal", etc.).
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell + typical Windows-launched scripts benefit too.
*.ps1 text eol=crlf

# Python + JS + config: standard text with LF (git default).
*.py     text
*.js     text
*.json   text
*.toml   text
*.md     text
*.yml    text
*.yaml   text
*.txt    text

# Binary blobs: mark explicit so git-archive doesn't try eol conversion.
*.pth    binary
*.pt     binary
*.onnx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.mp4    binary
*.mov    binary
*.zip    binary
*.otf    binary
*.ttf    binary
*.exe    binary
*.dll    binary
